# ==========================================================
# KONFIGURASI PRODUCTION CPANEL DOMAINESIA (ilufamoldingindent.com)
# ==========================================================
NODE_ENV=production
PORT=3000

# 1. DATABASE UTAMA (PostgreSQL cPanel DomaiNesia)
# Buat database & user di cPanel -> PostgreSQL Databases
# Format: postgresql://<user>:<password>@localhost:5432/<dbname>?schema=public
DATABASE_URL="postgresql://ilufamol_user:password_database_anda@localhost:5432/ilufamol_db?schema=public"

# 2. NONAKTIFKAN FIRESTORE (Gunakan 100% database PostgreSQL real)
DISABLE_FIRESTORE=true

# 3. REMOTE KILL-SWITCH / KONTROL LISENSI DARI GITHUB
# Jika client belum bayar / bermasalah, Anda cukup ubah "active": false di file license.json pada repo GitHub Anda.
# Website di cPanel otomatis terkunci dalam 60 detik tanpa perlu login ke cPanel.
REMOTE_LICENSE_URL=https://raw.githubusercontent.com/rizkijklmn/ilufa-molding/production/license.json

# 4. KEAMANAN CMS & ADMIN
ADMIN_PASSWORD=admin123
ADMIN_TOKEN_SECRET=ilufa-molding-cpanel-secret-2026

# 5. INTEGRASI WHATSAPP & CLIENT
VITE_API_URL=/api
VITE_WHATSAPP_NUMBER=6289676181754
